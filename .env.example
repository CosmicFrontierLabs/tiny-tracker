# Database
DATABASE_URL=postgres://postgres:postgres@localhost:5433/action_tracker

# Development mode - bypasses OAuth, uses dev user
DEV_MODE=true
DEV_USER_ID=1

# JWT (dev mode uses a default secret if not set)
# JWT_SECRET=your-secret-here

# OAuth (not needed in dev mode)
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=

# Server
PORT=8080
PUBLIC_URL=http://localhost:8080

# Email domain restriction (empty = allow all, not needed in dev mode)
# ALLOWED_EMAIL_DOMAINS=cosmicfrontier.org

# --- Outbound email (vendor portal magic links) ---
# smtp | resend | log. Defaults to "log" in dev mode (link is printed to the
# server log instead of being sent) and "smtp" otherwise.
MAIL_BACKEND=log
MAIL_FROM=Action Tracker <notifications@tracker.cosmicfrontier.org>

# MAIL_BACKEND=smtp - two ways to authorise.
#
# (a) Workspace SMTP relay, authorised by static egress IP. Leave BOTH
#     SMTP_USER and SMTP_PASSWORD unset; allowlist the egress IP under
#     Admin -> Apps -> Google Workspace -> Gmail -> Routing -> SMTP relay service.
# SMTP_HOST=smtp-relay.gmail.com
# SMTP_PORT=587
#
# (b) Authenticated SMTP with an app password. SMTP_USER must be a licensed
#     Workspace user (not an alias or group) with 2-step verification on.
#     Enable DKIM for the sending subdomain in the Admin Console separately.
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=notifications@tracker.cosmicfrontier.org
# SMTP_PASSWORD=
#
# Setting exactly one of SMTP_USER/SMTP_PASSWORD is rejected at startup as a
# likely typo.
#
# EHLO domain. Defaults to the MAIL_FROM domain, which is what the Workspace
# relay wants to see. Only set this if the relay needs a different hostname —
# never leave it to the library default, which is the container ID in Docker.
# SMTP_HELO_NAME=tracker.cosmicfrontier.org

# MAIL_BACKEND=resend - needs SPF/DKIM/DMARC on the sending subdomain.
# RESEND_API_KEY=
